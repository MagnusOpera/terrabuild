import "_protocol.fss" as Protocol
import "_helpers.fss" as Helpers

export let defaults (context: Protocol.ExtensionContext) =
  { Id = None
    DependencyResolution = None
    Outputs = []
    Dependencies = [] }
export let dispatch (context: Protocol.ActionContext) =
  { PreserveProvenance = Unaffected
    Batchable = false
    Operations = [] }
export let fake (context: Protocol.ActionContext) =
  { PreserveProvenance = Unaffected
    Batchable = false
    Operations = [] }

// Exported functions and Terrabuild execution flags.
{ [nameof defaults] = [Default]
  [nameof dispatch] = [Dispatch; Never]
  [nameof fake] = [Never] }
