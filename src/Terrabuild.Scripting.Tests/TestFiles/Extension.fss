export let run (context: {| Command: string |}) = "run"
export let dispatch (context: {| Command: string |}) = "dispatch"
export let defaults (context: {| Directory: string |}) = "defaults"

let hidden _ = "hidden"


type ExportFlag =
  | Dispatch
  | Default
  | Never
  | Local
  | External
  | Remote

{ [nameof run] = [ExportFlag.Local]
  [nameof dispatch] = [ExportFlag.Dispatch]
  [nameof defaults] = [ExportFlag.Default] }
