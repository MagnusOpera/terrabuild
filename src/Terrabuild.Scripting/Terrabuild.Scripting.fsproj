<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseLocalFScript Condition="'$(UseLocalFScript)' == ''">false</UseLocalFScript>
    <FScriptVersion Condition="'$(FScriptVersion)' == ''">0.86.3</FScriptVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Contracts.fs" />
    <Compile Include="FScriptProtocol.fs" />
    <Compile Include="TypeHelpers.fs" />
    <Compile Include="Scripting.fs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFScript)' != 'true'">
    <PackageReference Include="MagnusOpera.FScript.Language" Version="$(FScriptVersion)" />
    <PackageReference Include="MagnusOpera.FScript.Runtime" Version="$(FScriptVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFScript)' == 'true'">
    <ProjectReference Include="../../../FScript/FScript/src/FScript.Language/FScript.Language.fsproj" />
    <ProjectReference Include="../../../FScript/FScript/src/FScript.Runtime/FScript.Runtime.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Terrabuild.Expression/Terrabuild.Expression.fsproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFScriptExtensibility)' != 'true'">
    <PackageReference Include="MagnusOpera.FScript.Extensibility" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalFScriptExtensibility)' == 'true'">
    <ProjectReference Include="../../../FScript/FScript.Extensibility/src/FScript.Extensibility/FScript.Extensibility.fsproj" />
  </ItemGroup>
</Project>
